# BoppOS Containerfile.base
#
# A high-performance, atomic image based on CachyOS.
# Foundation layer including bootc and hardware enablement.

# Global build arguments must be declared before FROM to be used in image tags
ARG TARGET_CPU_MARCH=v3
ARG BASE_IMAGE_TAG=v3
ARG BASE_IMAGE=docker.io/cachyos/cachyos-${BASE_IMAGE_TAG}
ARG VERBOSE=false

# ==========================================
# System Build
# ==========================================
FROM ghcr.io/ublue-os/brew:latest AS brew

FROM ${BASE_IMAGE} AS system
ARG TARGET_CPU_MARCH
ARG BASE_IMAGE_TAG
ARG VERBOSE
ENV LANG=en_US.UTF-8
ENV PYTHONHASHSEED=0

# Copy Homebrew
COPY --from=brew /system_files /
RUN setfattr -n user.component -v "homebrew" "/usr/share/homebrew.tar.zst"

# Copy the shared directory from the bootcrew/mono repo
COPY files/base/bootcrew-shared/ /bootcrew-shared/

COPY files/keys/ /tmp/keys/
COPY scripts/ /tmp/scripts/

# Re-initialize and trust keys and configure pacman repositories
RUN chmod +x /tmp/scripts/*.sh && \
    /tmp/scripts/setup_pacman_repos.sh

RUN --mount=type=bind,source=mirrors,target=/workspace-mirrors \
    cp /workspace-mirrors/cachyos-mirrorlist /etc/pacman.d/cachyos-mirrorlist \
    && cp /workspace-mirrors/cachyos-v3-mirrorlist /etc/pacman.d/cachyos-v3-mirrorlist \
    && if [ "$TARGET_CPU_MARCH" == "v4" ] || [ "$TARGET_CPU_MARCH" == "znver4" ]; then \
    cp /workspace-mirrors/cachyos-v4-mirrorlist /etc/pacman.d/cachyos-v4-mirrorlist; \
    fi

RUN mkdir -p /etc/pacman.d/hooks && \
    ln -sf /dev/null /etc/pacman.d/hooks/90-mkinitcpio-install.hook && \
    ln -sf /dev/null /etc/pacman.d/hooks/90-dracut-install.hook && \
    ln -sf /dev/null /etc/pacman.d/hooks/systemd-hwdb.hook && \
    ln -sf /dev/null /etc/pacman.d/hooks/udev-hwdb.hook && \
    ln -sf /dev/null /etc/pacman.d/hooks/archlinux-keyring-wkd-sync.hook

RUN rm -rf /var/lib/pacman/sync/* && \
    pacman -Syy --noconfirm && \
    pacman -Su --noconfirm && \
    { pkill -9 gpg-agent || true; pkill -9 dirmngr || true; pkill -9 keyboxd || true; pkill -9 scdaemon || true; }

# Tag pacman config, mirrorlists, and sysimage database to avoid ostree layer hash non-determinism
RUN find /etc/pacman.conf /etc/pacman.d /usr/share/pacman/keyrings ! -type l -exec setfattr -n user.component -v "pacman-config" {} + -exec setfattr -n user.update-interval -v "weekly" {} + && \
    if [ -d /usr/lib/sysimage ]; then find /usr/lib/sysimage ! -type l -exec setfattr -n user.component -v "pacman-db" {} + -exec setfattr -n user.update-interval -v "daily" {} +; fi

# Ensure the log file exists
RUN touch /var/log/pacman.log

# Move pacman directories for bootc/usroverlay compatibility
# Also add NoExtract rules to strip documentation and non-English locales to save space
RUN grep "= */var" /etc/pacman.conf | grep -v "CacheDir" | sed "/= *\/var/s/.*=// ; s/ //" | xargs -n1 sh -c 'mkdir -p "/usr/lib/sysimage/$(dirname $(echo $1 | sed "s@/var/@@"))" && mv -v "$1" "/usr/lib/sysimage/$(echo "$1" | sed "s@/var/@@")"' '' && \
    sed -i -e "/^CacheDir/!s@= */var@= /usr/lib/sysimage@g" -e "/DownloadUser/d" /etc/pacman.conf && \
    mkdir -p /usr/lib/sysimage/cache/pacman /var/lib && \
    rm -rf /usr/lib/sysimage/cache/pacman/pkg && \
    ln -sf /var/cache/pacman/pkg /usr/lib/sysimage/cache/pacman/pkg && \
    ln -sf /usr/lib/sysimage/lib/pacman /var/lib/pacman && \
    sed -i '/^\[options\]/a NoExtract = usr/share/help/* usr/share/gtk-doc/html/* usr/share/doc/*\nNoExtract = usr/share/locale/* usr/share/man/??/* usr/share/man/??_*/*\nNoExtract = !usr/share/locale/en_US/* !usr/share/locale/locale.alias' /etc/pacman.conf

# PRE-INSTALL CONFIGURATION & HOOKS
# Copy hooks and configs EARLY so they fire during the master pacman block.
COPY files/base/usr/share/libalpm/hooks/assign-usercomponent.hook /usr/share/libalpm/hooks/assign-usercomponent.hook
COPY files/base/usr/libexec/assign-usercomponent.sh /usr/libexec/assign-usercomponent.sh
RUN chmod +x /usr/libexec/assign-usercomponent.sh

# Generate en_US.UTF-8 locale
RUN sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    locale-gen && \
    echo "LANG=en_US.UTF-8" > /etc/locale.conf

# Dracut i18n fix
RUN mkdir -p /usr/lib/dracut/dracut.conf.d && \
    echo 'i18n_vars="/usr/share/kbd/consolefonts  /usr/share/kbd/keymaps"' >> /usr/lib/dracut/dracut.conf.d/boppos-cachyos.conf

# ==========================================
# PACMAN CACHE CLEANUP
# ==========================================
RUN rm -f /usr/lib/sysimage/cache/pacman/pkg/lua* && \
    rm -f /usr/lib/sysimage/cache/pacman/pkg/*.part && \
    if ! mountpoint -q /usr/lib/sysimage/cache/pacman/pkg; then \
    pacman -Sc --noconfirm ; \
    fi

# ==========================================
# MASTER PACKAGE INSTALLATION
# ==========================================

RUN --mount=type=tmpfs,dst=/run \
    pacman -Rdd --noconfirm pulseaudio pulseaudio-bluetooth || true

RUN --mount=type=tmpfs,dst=/run \
    pacman -Sy --noconfirm --ask 4 --needed \
    python python-yaml yq

COPY scripts/install_packages.sh /tmp/install_packages.sh
COPY files/base/base.yaml /tmp/base.yaml

RUN --mount=type=tmpfs,dst=/run \
    chmod +x /tmp/install_packages.sh && \
    if [ "$VERBOSE" = "true" ]; then VERBOSE_ARG="--verbose"; else VERBOSE_ARG=""; fi && \
    /tmp/install_packages.sh /tmp/base.yaml $VERBOSE_ARG

# ==========================================
# POST-INSTALL CONFIGURATION
# ==========================================

# Re-copy configurations and hooks to restore any custom files overwritten by packages
COPY files/base/usr/share /usr/share
COPY files/base/etc /etc
COPY files/base/usr/lib /usr/lib
COPY files/base/usr/libexec /usr/libexec

RUN chmod +x /usr/share/boppos/bootc-cleanup.sh && \
    chmod -R 0755 /usr/libexec && \
    find /etc /usr/share/boppos /usr/libexec -type f \
        -exec sh -c 'for f; do getfattr -h -n user.component "$f" &>/dev/null || { setfattr -h -n user.component -v "boppos-custom" "$f" && setfattr -h -n user.update-interval -v "daily" "$f"; }; done' sh {} +

# Link OS default font configuration
RUN mkdir -p /etc/fonts/conf.d && ln -sf /usr/share/fontconfig/conf.avail/52-boppos-fonts.conf /etc/fonts/conf.d/52-boppos-fonts.conf

# Master copy of custom executables. Overwrites defaults (like steamos-update).
# This is commented out intentionally. Git does not track empty directories,
# and including this line causes the build to fail if the dir is empty.
# COPY files/base/usr/bin /usr/bin
RUN chmod -R 0755 /usr/bin /usr/share/libalpm/scripts

# Fix Howdy's write path to snapshots on read-only /usr filesystem by linking it to /var
RUN mkdir -p /usr/lib/security/howdy && \
    ln -sf /var/lib/howdy/snapshots /usr/lib/security/howdy/snapshots


RUN if [ -e /usr/etc ]; then \
    echo "Workaround: mitigating rogue /usr/etc to satisfy bootc..." && \
    if [ ! -L /usr/etc ] && [ -n "$(ls -A /usr/etc 2>/dev/null)" ]; then cp -a /usr/etc/* /etc/ 2>/dev/null || true; fi && \
    rm -rf /usr/etc; \
    fi

# Configure Flatpak with retry logic to handle transient network issues
RUN for i in {1..5}; do \
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo && break || \
    echo "Flatpak remote-add failed (attempt $i), retrying in 5 seconds..." && sleep 5; \
    done && \
    find /var/lib/flatpak /etc/flatpak -type f 2>/dev/null | xargs -r sh -c \
    'for f; do getfattr -h -n user.component "$f" &>/dev/null || { setfattr -h -n user.component -v "flatpak-config" "$f" && setfattr -h -n user.update-interval -v "weekly" "$f"; }; done' sh

# Fix suid permissions
RUN for f in \
    /usr/bin/sudo \
    /usr/bin/pkexec \
    /usr/bin/su \
    /usr/bin/unix_chkpwd \
    /usr/lib/polkit-1/polkit-agent-helper-1 \
    /usr/bin/passwd \
    /usr/bin/chsh \
    /usr/bin/chfn \
    /usr/bin/newgrp \
    /usr/bin/newuidmap \
    /usr/bin/newgidmap \
    /usr/bin/mount \
    /usr/bin/umount \
    /usr/bin/fusermount \
    /usr/bin/fusermount3 \
    /usr/bin/chage \
    /usr/bin/expiry \
    /usr/bin/gpasswd \
    /usr/bin/ksu \
    /usr/bin/sg \
    /usr/lib/dbus-daemon-launch-helper \
    /usr/lib/ssh/ssh-keysign \
    ; do if [ -f "$f" ]; then chmod 4755 "$f"; fi; done

RUN echo 'g sambashare - -' > /usr/lib/sysusers.d/sambashare.conf && \
    systemd-sysusers

# Disable SELinux labeling in Podman
RUN mkdir -p /etc/containers/containers.conf.d && \
    printf '[containers]\nlabel = false\n' > /etc/containers/containers.conf.d/01-no-selinux.conf

# Enable required systemd services
RUN systemctl enable var-opt.mount && \
    systemctl enable NetworkManager.service && \
    systemctl enable systemd-resolved.service && \
    systemctl enable avahi-daemon.service && \
    systemctl enable dbus-broker.service && \
    systemctl enable bluetooth.service && \
    systemctl enable ModemManager.service && \
    systemctl enable ananicy-cpp.service && \
    systemctl enable scx_loader.service && \
    systemctl enable brew-setup.service && \
    systemctl enable power-profiles-daemon.service && \
    systemctl enable fstrim.timer && \
    systemctl enable boppos-update-monitor.timer && \
    systemctl enable cups.socket && \
    systemctl enable docker.socket && \
    systemctl disable asusd.service supergfxd.service || true

# Bootc / Dracut Fixes
RUN --mount=type=tmpfs,dst=/run \
    mkdir -p /usr/lib/dracut/dracut.conf.d/ && \
    printf "systemdsystemconfdir=/etc/systemd/system\nsystemdsystemunitdir=/usr/lib/systemd/system\n" | tee /usr/lib/dracut/dracut.conf.d/30-boppos-fix-bootc-module.conf && \
    printf 'reproducible="yes"\nhostonly=no\ncompress=zstd\nadd_dracutmodules+=" ostree bootc crypt systemd-cryptsetup tpm2-tss drm plymouth btrfs i18n "\nforce_drivers+=" i915 xe amdgpu nouveau "\n' | tee "/usr/lib/dracut/dracut.conf.d/30-boppos-dracut-container-build.conf" && \
    KERNEL_DIR="$(find /usr/lib/modules -maxdepth 1 -type d | grep -v -E '\\.img$' | sort -V | tail -n 1)" && \
    KERNEL_VER="$(basename "$KERNEL_DIR")" && \
    depmod -a "$KERNEL_VER" && \
    SOURCE_DATE_EPOCH=0 dracut --force --reproducible "$KERNEL_DIR/initramfs.img" "$KERNEL_VER" && \
    find /usr/lib/modules -type f -exec setfattr -h -n user.component -v "kernel-initramfs" {} + -exec setfattr -h -n user.update-interval -v "daily" {} +

# Preserve /opt contents for OverlayFS
RUN mkdir -p /usr/lib/opt && \
    if [ -d /opt ] && [ "$(ls -A /opt)" ]; then \
    mv /opt/* /usr/lib/opt/ || true; \
    fi


# Apply update intervals before bootc cleanup
COPY scripts/package-intervals.json /tmp/package-intervals.json
COPY scripts/apply-update-intervals.sh /tmp/apply-update-intervals.sh
RUN chmod +x /tmp/apply-update-intervals.sh && \
    if [ "$VERBOSE" = "true" ]; then VERBOSE_ARG="--verbose"; else VERBOSE_ARG=""; fi && \
    /tmp/apply-update-intervals.sh /tmp/package-intervals.json / $VERBOSE_ARG

# Final system setup and cleanup
RUN sed -i 's|^HOME=.*|HOME=/var/home|' "/etc/default/useradd" && \
    mkdir -p /run /tmp && \
    # Patch the cleanup script to NOT delete our mounted pacman cache
    ( [ -f /bootcrew-shared/bootc-rootfs.sh ] && sed -i 's|/usr/lib/sysimage/cache/pacman/pkg||g' /bootcrew-shared/bootc-rootfs.sh || true ) && \
    bash /bootcrew-shared/bootc-rootfs.sh && \
    rm -rf /bootcrew-shared && \
    /usr/share/boppos/bootc-cleanup.sh

RUN ln -sf ../usr/lib/os-release /etc/os-release
RUN ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime

# Add repository security keys
RUN mkdir -p /etc/pki/containers
COPY cosign.pub /etc/pki/containers/bopp-os.pub

# Make the package list generator executable for downstream flavors
RUN chmod +x /usr/share/boppos/generate-package-list.sh

RUN rm -f /README.md

# Reset Python hashseed to default random for runtime security
ENV PYTHONHASHSEED=""

LABEL containers.bootc=1
