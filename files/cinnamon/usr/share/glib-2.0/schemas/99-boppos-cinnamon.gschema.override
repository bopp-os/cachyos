# BoppOS Cinnamon Session & GTK Defaults

[org.cinnamon.desktop.interface]
gtk-theme='Mint-Y'
icon-theme='Mint-Y'
font-name='Noto Sans 10'

[org.cinnamon.theme]
name='Mint-Y'

[org.cinnamon.desktop.background]
picture-uri='file:///usr/share/wallpapers/cachyos-wallpapers/Cachy_Topography.jpg'
picture-options='zoom'

[org.cinnamon.desktop.sound]
theme-name='freedesktop'

[org.gnome.desktop.interface]
gtk-theme='Mint-Y'
icon-theme='Mint-Y'
font-name='Noto Sans 10'

[org.gnome.desktop.sound]
theme-name='freedesktop'
