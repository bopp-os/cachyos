[Default Applications]
# File Manager / Directories -> Dolphin
inode/directory=org.kde.dolphin.desktop

# Text files & Code -> Kate
text/plain=org.kde.kate.desktop
text/markdown=org.kde.kate.desktop
text/x-python=org.kde.kate.desktop
text/x-shellscript=org.kde.kate.desktop
application/x-shellscript=org.kde.kate.desktop
text/x-c=org.kde.kate.desktop
text/x-c++=org.kde.kate.desktop
text/csv=org.kde.kate.desktop
text/xml=org.kde.kate.desktop
application/xml=org.kde.kate.desktop
application/json=org.kde.kate.desktop
text/x-yaml=org.kde.kate.desktop
application/x-yaml=org.kde.kate.desktop
text/x-toml=org.kde.kate.desktop

# Image formats -> Gwenview
image/bmp=org.kde.gwenview.desktop
image/gif=org.kde.gwenview.desktop
image/jpeg=org.kde.gwenview.desktop
image/jpg=org.kde.gwenview.desktop
image/pjpeg=org.kde.gwenview.desktop
image/png=org.kde.gwenview.desktop
image/svg+xml=org.kde.gwenview.desktop
image/svg+xml-compressed=org.kde.gwenview.desktop
image/webp=org.kde.gwenview.desktop
image/avif=org.kde.gwenview.desktop
image/heif=org.kde.gwenview.desktop
image/x-png=org.kde.gwenview.desktop
image/tiff=org.kde.gwenview.desktop

# Video formats -> Haruna (with mpv fallback)
video/mp4=org.kde.haruna.desktop;mpv.desktop;
video/x-matroska=org.kde.haruna.desktop;mpv.desktop;
video/webm=org.kde.haruna.desktop;mpv.desktop;
video/x-msvideo=org.kde.haruna.desktop;mpv.desktop;
video/quicktime=org.kde.haruna.desktop;mpv.desktop;
video/mpeg=org.kde.haruna.desktop;mpv.desktop;
video/ogg=org.kde.haruna.desktop;mpv.desktop;

# Audio formats -> Haruna (with mpv fallback)
audio/mpeg=org.kde.haruna.desktop;mpv.desktop;
audio/x-wav=org.kde.haruna.desktop;mpv.desktop;
audio/ogg=org.kde.haruna.desktop;mpv.desktop;
audio/flac=org.kde.haruna.desktop;mpv.desktop;
audio/x-vorbis+ogg=org.kde.haruna.desktop;mpv.desktop;
audio/x-opus+ogg=org.kde.haruna.desktop;mpv.desktop;
audio/aac=org.kde.haruna.desktop;mpv.desktop;
audio/mp4=org.kde.haruna.desktop;mpv.desktop;

# Archives -> Ark
application/zip=org.kde.ark.desktop
application/x-7z-compressed=org.kde.ark.desktop
application/x-7z-compressed-tar=org.kde.ark.desktop
application/x-bzip=org.kde.ark.desktop
application/x-bzip-compressed-tar=org.kde.ark.desktop
application/x-compress=org.kde.ark.desktop
application/x-compressed-tar=org.kde.ark.desktop
application/x-cpio=org.kde.ark.desktop
application/x-gzip=org.kde.ark.desktop
application/x-lha=org.kde.ark.desktop
application/x-lzip=org.kde.ark.desktop
application/x-lzma=org.kde.ark.desktop
application/x-lzop=org.kde.ark.desktop
application/x-rar=org.kde.ark.desktop
application/x-rar-compressed=org.kde.ark.desktop
application/x-tar=org.kde.ark.desktop
application/x-tarz=org.kde.ark.desktop
application/x-xar=org.kde.ark.desktop
