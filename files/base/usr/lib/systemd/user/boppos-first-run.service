[Unit]
Description=BoppOS first-run app
Documentation=https://github.com/bopp-os/boppos-tools
# The installer writes the marker (mode=welcome or mode=oobe); boppos-deck deletes it when the first run is done.
ConditionPathExists=/var/lib/boppos/first-run
# Only with a display in the user manager's environment. Plasma, GNOME and niri import it before
# graphical-session.target; a session that does not (gamescope-session-plus today) skips the unit instead of
# failing, and can start it later with: systemctl --user import-environment DISPLAY && systemctl --user start ...
ConditionEnvironment=|WAYLAND_DISPLAY
ConditionEnvironment=|DISPLAY
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# The only trigger for the first-run app: the image removes boppos-tools' bopp-welcome.desktop autostart entry and
# masks boppos-oobe.service. oneshot + RemainAfterExit keeps the unit active after the app exits, so further start
# requests in this user manager (one per user, shared by all of that user's sessions) do nothing until the
# graphical session ends; a first run left unfinished comes back at the next login, never in a loop.
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
ExecStart=/usr/bin/boppos-deck --first-run

[Install]
WantedBy=graphical-session.target
