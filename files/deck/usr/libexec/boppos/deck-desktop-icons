#!/usr/bin/bash
# XDG autostart in Plasma (boppos-deck-desktop-icons.desktop): puts "Return to Gaming Mode" on the desktop, as SteamOS
# and CachyOS Handheld do. New accounts get it from /etc/skel/Desktop; this covers accounts made before the image
# shipped it. Once per account: delete the icon and it stays gone.
set -u

marker="${XDG_STATE_HOME:-$HOME/.local/state}/boppos/desktop-icons-offered"
[ -e "$marker" ] && exit 0

desktop=$(xdg-user-dir DESKTOP 2> /dev/null || echo "$HOME/Desktop")
[ -n "$desktop" ] && [ "$desktop" != "$HOME" ] || desktop="$HOME/Desktop"
mkdir -p "$desktop"
if [ ! -e "$desktop/steamos-gamemode.desktop" ]; then
    # Executable, so Plasma runs it without asking whether to trust it
    install -m 0755 /usr/share/applications/steamos-gamemode.desktop "$desktop/steamos-gamemode.desktop"
fi
mkdir -p "$(dirname "$marker")"
touch "$marker"
