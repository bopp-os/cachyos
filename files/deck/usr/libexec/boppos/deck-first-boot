#!/usr/bin/bash
# Runs at the start of the Game Mode session, before its gamescope (boppos-deck-first-boot.service, a user unit
# ordered before gamescope-session.service). When something Steam needs is missing it opens boppos-deck as the only
# app in a gamescope of its own, so a fresh install never sits on a black screen while Steam fails offline or
# downloads its client.
#
# Something is missing when:
#  - the installer's first-run marker is still there (the welcome tour has not been finished), or
#  - Steam has not downloaded its client yet (no steamui.so), and then also when there is no network.
# Being offline alone is fine once Steam is installed: Steam has an offline mode, so a handheld on a plane is not
# stopped every boot.
#
# What boppos-deck shows is its own business. It gets the list of what is missing in BOPPOS_FIRST_BOOT_MISSING
# (space-separated: first-run, network, steam). If the network is still down when it exits (a boppos-tools without
# a network step), the Plasma network settings open as a fallback so the user can connect.
# It always exits 0: Steam starts afterwards whatever happened here.
set -u

MARKER=/var/lib/boppos/first-run
STEAM_DIR="$HOME/.local/share/Steam"
log() { echo "deck-first-boot: $*" >&2; }

steam_installed() {
    [ -e "$STEAM_DIR/ubuntu12_64/steamui.so" ] || [ -e "$STEAM_DIR/ubuntu12_32/steamui.so" ]
}

# A connection is up (Wi-Fi joined or a cable). Waits a little, since the first boot can still be joining.
online() {
    command -v nm-online > /dev/null || return 1
    nm-online -q -t "${1:-20}"
}

inside() {
    if [ -x /usr/bin/boppos-deck ]; then
        # --first-run picks the flow itself while the marker exists; without it, force the welcome tour.
        flow=--welcome
        [ -e "$MARKER" ] && flow=--first-run
        # PYTHONFAULTHANDLER: a crash prints the Python stack to the journal (boppos-deck is Python + GTK4).
        # ADW_DEBUG_COLOR_SCHEME: dark, like Game Mode. There is no settings portal before Steam, so libadwaita
        # would otherwise fall back to light.
        run_deck() {
            BOPPOS_FIRST_BOOT_MISSING="${missing[*]}" GDK_BACKEND=x11 PYTHONFAULTHANDLER=1 \
                ADW_DEBUG_COLOR_SCHEME=prefer-dark "$@" /usr/bin/boppos-deck "$flow"
        }
        run_deck env
        rc=$?
        # Killed by a signal (GTK's GL renderer has segfaulted under gamescope's Xwayland): retry once without GL.
        if [ "$rc" -gt 128 ]; then
            log "boppos-deck crashed ($rc), retrying with GSK_RENDERER=cairo"
            run_deck env GSK_RENDERER=cairo
            rc=$?
        fi
        [ "$rc" -eq 0 ] || log "boppos-deck exited with $rc"
    else
        log "boppos-deck is not installed"
    fi

    # Fallback: still offline and Steam still missing, so Steam would only show a black screen. Give the user the
    # network settings (plasma-nm), one window in gamescope.
    if ! steam_installed && ! online 3 && command -v kcmshell6 > /dev/null; then
        log "still offline, opening the network settings"
        # Never blocks Steam for good: stop it once a connection is up,
        # and after 10 minutes at the most.
        QT_QPA_PLATFORM=xcb kcmshell6 kcm_networkmanagement &
        kcm=$!
        for _ in $(seq 120); do
            kill -0 "$kcm" 2> /dev/null || break
            if online 1; then log "connected"; break; fi
            sleep 5
        done
        kill "$kcm" 2> /dev/null && log "closed the network settings"
        wait "$kcm" 2> /dev/null
    fi
}

# Inside our own gamescope (see the end of this file): show the setup, then return to the session.
if [ "${1:-}" = --inside ]; then
    read -r -a missing <<< "${BOPPOS_FIRST_BOOT_MISSING:-}"
    inside
    exit 0
fi

missing=()
[ -e "$MARKER" ] && missing+=(first-run)
if ! steam_installed; then
    missing+=(steam)
    online || missing+=(network)
fi

if [ ${#missing[@]} -eq 0 ]; then
    exit 0
fi
log "missing: ${missing[*]}"

# boppos-deck gets a gamescope of its own, as the only app, like boppos-oobe.service: the session's gamescope
# runs in Steam mode and only shows the windows Steam tells it to, so nothing appears there before Steam.
# No -e (Steam mode) here for the same reason. Game Mode's gamescope starts after this one exits.
# --default-touch-mode 4 (passthrough): the app gets real touch events, so a finger drag scrolls. The default turns
# touches into mouse clicks, and GTK does not scroll on a mouse drag.
export BOPPOS_FIRST_BOOT_MISSING="${missing[*]}"
gamescope --backend drm --force-windows-fullscreen --default-touch-mode 4 -- "$0" --inside ||
    log "gamescope exited with $?"
exit 0

