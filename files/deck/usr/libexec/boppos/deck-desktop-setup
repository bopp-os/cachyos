#!/usr/bin/bash
# XDG autostart in Plasma (boppos-deck-desktop-setup.desktop). Puts "Return to Gaming Mode" on the desktop once per
# account, so a deleted icon stays gone. Accounts created after the image shipped it get it from /etc/skel/Desktop;
# this covers older ones. (Steam's autostart and the KWin setting that lets it control input without a prompt,
# XwaylandEisNoPrompt, come from cachyos-handheld.)
set -u

state="${XDG_STATE_HOME:-$HOME/.local/state}/boppos"
mkdir -p "$state"
[ -e "$state/desktop-icons-offered" ] && exit 0

desktop=$(xdg-user-dir DESKTOP 2> /dev/null || echo "$HOME/Desktop")
[ -n "$desktop" ] && [ "$desktop" != "$HOME" ] || desktop="$HOME/Desktop"
mkdir -p "$desktop"
if [ ! -e "$desktop/steamos-gamemode.desktop" ]; then
    # Executable, so Plasma runs it without asking whether to trust it
    install -m 0755 /usr/share/applications/steamos-gamemode.desktop "$desktop/steamos-gamemode.desktop"
fi
touch "$state/desktop-icons-offered"
