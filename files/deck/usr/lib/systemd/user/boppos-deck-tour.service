[Unit]
Description=Open the BoppOS welcome tour from Steam (first run)
Documentation=file:///usr/libexec/boppos/deck-tour
# Pulled in by steam-launcher.service (see its drop-in); only while the installer's first-run marker exists.
ConditionPathExists=/var/lib/boppos/first-run
After=steam-launcher.service
PartOf=graphical-session.target

[Service]
# Once per session: it restarts Steam itself, and a Steam restart must not open the tour again
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=infinity
ExecStart=/usr/libexec/boppos/deck-tour
Slice=session.slice
