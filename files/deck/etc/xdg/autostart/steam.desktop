[Desktop Entry]
# Steam in the background on the desktop, as on SteamOS: its desktop controller layout makes the handheld's
# controls work as a mouse and keyboard there. Named like the file Steam writes for "Run Steam when my computer
# starts" (~/.config/autostart/steam.desktop), so that setting and Plasma's Autostart page override this one.
Type=Application
Name=Steam
Comment=Start Steam in the background for the controller's desktop controls
Exec=steam -silent
Icon=steam
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
